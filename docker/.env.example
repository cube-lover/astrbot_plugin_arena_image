# Find the existing AstrBot network with: docker network ls
ASTRBOT_NETWORK=astrbot_default

# Set strong values before starting the service.
LM_BRIDGE_ADMIN_PASSWORD=CHANGE_ME
LM_BRIDGE_API_KEY=
LM_BRIDGE_RPM=30

# Arena hides a gray-test checkpoint by shipping its row without an
# `organization` field.  Those models work like any other, so they are exposed
# by default; set this to 0 to list only branded models.
LM_BRIDGE_ALLOW_STEALTH_MODELS=1

# Optional visible server browser for manual Arena/Cloudflare verification.
# The CDP address is internal to the Docker network; the VNC URL is the
# address reachable from the operator's browser.
LM_BRIDGE_BROWSER_CDP_URL=http://arena-browser:9223
LM_BRIDGE_BROWSER_VNC_URL=http://HOST:6082/vnc.html?autoconnect=true&resize=scale
LM_BRIDGE_BROWSER_GATEWAY_URL=http://HOST:6081

# Host port the verification gateway is published on (inside the container it is
# always 6081).  Change this one line if 6081 is taken on your server; setup.sh
# puts the same port into LM_BRIDGE_BROWSER_GATEWAY_URL and into
# arena-browser-data/gateway-url.txt, which is what the plugin reads -- so the
# plugin config stays empty either way.  Remember to open the new port in the
# firewall / security group.
ARENA_GATEWAY_PORT=6081

# Create .interactive-link-secret on the server with a random value and keep
# it mode 600.  The gateway uses it to validate short-lived verification URLs.
# The VNC password is read from .novnc-password on the server and is never
# placed in this file or in chat messages.


# Which host address the CDP port (9223) is published on.  Direct mode only
# needs this when AstrBot cannot reach the container name `arena-browser`.
#   127.0.0.1  (default) only this machine; enough for an AstrBot installed on
#              the host rather than in Docker.
#   172.17.0.1 the docker0 gateway: any container on this host can reach it, the
#              internet cannot.  Use it when AstrBot lives in another Docker
#              network and you would rather not attach it to this one -- the
#              plugin probes this address on its own, so nothing needs filling in.
# Never use 0.0.0.0 here: CDP is unauthenticated remote control of a browser that
# is logged into your Arena account, and it can read files inside the container.
ARENA_CDP_BIND=127.0.0.1

# Optional HTTP/HTTPS proxy for servers in mainland China.
# Leave empty on servers that can reach Arena directly (e.g. Hong Kong).
# Example: http://192.168.1.100:7890 or socks5://192.168.1.100:1080
LM_BRIDGE_PROXY_URL=
