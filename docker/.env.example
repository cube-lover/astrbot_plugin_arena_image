# Find the existing AstrBot network with: docker network ls
ASTRBOT_NETWORK=astrbot_default

# Set strong values before starting the service.
LM_BRIDGE_ADMIN_PASSWORD=CHANGE_ME
LM_BRIDGE_API_KEY=
LM_BRIDGE_RPM=30

# Optional visible server browser for manual Arena/Cloudflare verification.
# The CDP address is internal to the Docker network; the VNC URL is the
# address reachable from the operator's browser.
LM_BRIDGE_BROWSER_CDP_URL=http://agentrouter-browser:9233
LM_BRIDGE_BROWSER_VNC_URL=http://HOST:6080/vnc.html?autoconnect=true&resize=scale
LM_BRIDGE_BROWSER_GATEWAY_URL=http://HOST:6081

# Create .interactive-link-secret on the server with a random value and keep
# it mode 600.  The gateway uses it to validate short-lived verification URLs.
# The VNC password is read from .novnc-password on the server and is never
# placed in this file or in chat messages.
