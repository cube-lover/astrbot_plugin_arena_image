FROM mcr.microsoft.com/playwright/python:v1.49.0-jammy

USER root

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        fonts-noto-cjk \
        fluxbox \
        novnc \
        procps \
        websockify \
        x11vnc \
        xvfb \
    && rm -rf /var/lib/apt/lists/*

# Install current vendor stable Chrome from the signed Google repository.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl gnupg locales fonts-liberation fonts-noto-color-emoji \
    && install -d -m 0755 /etc/apt/keyrings \
    && curl --fail --silent --show-error --location --max-time 60 \
        https://dl.google.com/linux/linux_signing_key.pub \
        | gpg --dearmor -o /etc/apt/keyrings/google-chrome.gpg \
    && echo 'deb [arch=amd64 signed-by=/etc/apt/keyrings/google-chrome.gpg] https://dl.google.com/linux/chrome/deb/ stable main' \
        > /etc/apt/sources.list.d/google-chrome.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends google-chrome-stable \
    && sed -i '/^# zh_CN.UTF-8 UTF-8/s/^# //' /etc/locale.gen \
    && sed -i '/^# en_US.UTF-8 UTF-8/s/^# //' /etc/locale.gen \
    && locale-gen \
    && google-chrome-stable --version \
    && rm -rf /var/lib/apt/lists/*

ENV CHROME_BIN=/usr/bin/google-chrome-stable \
    LANG=zh_CN.UTF-8 \
    LC_ALL=zh_CN.UTF-8

RUN mkdir -p /app
COPY arena-browser-entrypoint.sh /usr/local/bin/arena-browser-entrypoint.sh
COPY novnc_gateway.py /app/novnc_gateway.py
COPY proxy_relay.py /app/proxy_relay.py
RUN sed -i "s/\r$//" /usr/local/bin/arena-browser-entrypoint.sh \
    && chmod 755 /usr/local/bin/arena-browser-entrypoint.sh

EXPOSE 6081 6082 9223

ENTRYPOINT ["/usr/local/bin/arena-browser-entrypoint.sh"]
